TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=my_ledger_bot
SECRET_KEY=change-me-to-a-long-random-string
# Bot login ("Log in with Telegram" button): the bot's webhook is registered at startup
# PUBLIC_URL=https://ledger.example.com
# TELEGRAM_WEBHOOK_SECRET=long-random-string
# DEV_LOGIN=1            # username-only login for local testing; never in production
# SESSION_COOKIE_SECURE=1 # when served over HTTPS
# POSTGRES_PASSWORD=ledger
# Daily backup of active loans as CSV, sent by the bot (recipient must have logged in once):
# BACKUP_TELEGRAM_USERNAME=your_username   # or BACKUP_CHAT_ID=123456
# BACKUP_TIME=09:00
# BACKUP_TZ=Europe/Kyiv
